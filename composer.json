{
    "name": "ver3k12/pterodactyl-location",
    "description": "Pterodactyl location addon; dependencies below are for standalone tests only.",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
